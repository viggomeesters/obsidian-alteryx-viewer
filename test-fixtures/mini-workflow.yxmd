<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2025.1" RunE2="T">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">.\input\input.xlsx|||Sheet1$</File>
        </Configuration>
        <Annotation DisplayMode="0">
          <AnnotationText>Read sample input</AnnotationText>
          <DefaultAnnotationText>input.xlsx</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="280" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Trim([Name])" field="CleanName" size="255" type="V_WString" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <AnnotationText>Clean name field</AnnotationText>
          <DefaultAnnotationText>CleanName = Trim([Name])</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="460" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>[CleanName] != ""</Expression>
        </Configuration>
        <Annotation DisplayMode="0">
          <AnnotationText>Keep named rows</AnnotationText>
          <DefaultAnnotationText>[CleanName] != ""</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFilter" />
    </Node>
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="640" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File MaxRecords="" FileFormat="25">.\output\cleaned.xlsx|||Clean$</File>
          <FormatSpecificOptions>
            <OutputOption>Overwrite</OutputOption>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <AnnotationText>Inspect output path only</AnnotationText>
          <DefaultAnnotationText>cleaned.xlsx</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileOutput" />
    </Node>
  </Nodes>
  <Connections>
    <Connection>
      <Origin ToolID="1" Connection="Output" />
      <Destination ToolID="2" Connection="Input" />
    </Connection>
    <Connection>
      <Origin ToolID="2" Connection="Output" />
      <Destination ToolID="3" Connection="Input" />
    </Connection>
    <Connection>
      <Origin ToolID="3" Connection="True" />
      <Destination ToolID="4" Connection="Input" />
    </Connection>
  </Connections>
  <Properties>
    <Memory default="True" />
    <GlobalRecordLimit value="0" />
    <DisableBrowse value="False" />
    <DisableAllOutput value="False" />
    <RunWithE2 value="True" />
    <LayoutType>Horizontal</LayoutType>
    <MetaInfo>
      <Name>Synthetic Mini Workflow</Name>
      <Description>Fixture workflow with input, formula, filter and output tools.</Description>
      <WorkflowId value="11111111-1111-1111-1111-111111111111" />
    </MetaInfo>
  </Properties>
</AlteryxDocument>
